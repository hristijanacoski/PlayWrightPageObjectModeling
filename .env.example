# Environment Configuration for Testing

# Base URL for testing (can override for different environments)
BASE_URL=https://www.saucedemo.com

# Test Credentials
TEST_USERNAME=standard_user
TEST_PASSWORD=secret_sauce

# Performance Testing Configuration
ARTILLERY_TARGET=https://www.saucedemo.com
ARTILLERY_DURATION=180
ARTILLERY_ARRIVAL_RATE=15

# API Testing Configuration
API_TIMEOUT=30000
API_RETRY_COUNT=3

# Browser Configuration
HEADLESS=true
SLOW_MO=0
